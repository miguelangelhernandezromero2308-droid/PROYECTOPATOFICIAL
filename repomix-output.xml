}

function dibujarPreview(origen, destino) {
    if (!mapaPreview) {
        mapaPreview = L.map("mapaPreview").setView([4.6534, -74.1162], 6);
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png").addTo(mapaPreview);
    }
