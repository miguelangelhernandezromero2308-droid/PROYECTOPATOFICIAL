<file path="estructura_PAT2.sql">
-- ============================================================================
-- SCRIPT INICIAL PAT (3 PARTES: TABLAS -> FORÁNEAS -> INSERCIONES)
-- Motor: MySQL / MariaDB (utf8mb4)
-- ============================================================================

SET NAMES utf8mb4;
SET @OLD_FOREIGN_KEY_CHECKS = @@FOREIGN_KEY_CHECKS;
SET FOREIGN_KEY_CHECKS = 0;

CREATE DATABASE IF NOT EXISTS `pat2`
  CHARACTER SET utf8mb4
  COLLATE utf8mb4_general_ci;

USE `pat2`;

-- ============================================================================
-- PARTE 1: CREACIÓN DE TABLAS
-- ============================================================================

DROP TABLE IF EXISTS `detalle_resenas`;
DROP TABLE IF EXISTS `resenas`;
DROP TABLE IF EXISTS `pago_proveedor`;
DROP TABLE IF EXISTS `pagos`;
DROP TABLE IF EXISTS `det_plan_viaje`;
DROP TABLE IF EXISTS `plan_viaje`;
DROP TABLE IF EXISTS `servicio_transporte`;
DROP TABLE IF EXISTS `servicio_recreacion`;
DROP TABLE IF EXISTS `servicio_imagen`;
DROP TABLE IF EXISTS `servicio_hospedaje`;
DROP TABLE IF EXISTS `servicio_guia`;
DROP TABLE IF EXISTS `servicio_gastronomia`;
DROP TABLE IF EXISTS `servicio_condicion`;
DROP TABLE IF EXISTS `servicio`;
DROP TABLE IF EXISTS `proveedor_tp_servicio`;
DROP TABLE IF EXISTS `proveedor`;
DROP TABLE IF EXISTS `solicitud_tp_servicio`;
DROP TABLE IF EXISTS `documentos`;
DROP TABLE IF EXISTS `solicitud_proveedor`;
DROP TABLE IF EXISTS `auditoria_rol`;
DROP TABLE IF EXISTS `usuario`;
DROP TABLE IF EXISTS `tp_turismo`;
DROP TABLE IF EXISTS `tp_servicio`;
DROP TABLE IF EXISTS `condiciones`;
DROP TABLE IF EXISTS `politica`;
DROP TABLE IF EXISTS `metodo_pago`;
DROP TABLE IF EXISTS `gama`;
DROP TABLE IF EXISTS `trayecto`;
DROP TABLE IF EXISTS `ubicacion`;
DROP TABLE IF EXISTS `ciudad`;
DROP TABLE IF EXISTS `departamento`;
DROP TABLE IF EXISTS `pais`;
DROP TABLE IF EXISTS `continente`;
DROP TABLE IF EXISTS `rol`;

CREATE TABLE `rol` (
  `id_rol` int(11) NOT NULL AUTO_INCREMENT,
  `nombre` varchar(50) NOT NULL,
  `descripcion` text DEFAULT NULL,
  PRIMARY KEY (`id_rol`),
  UNIQUE KEY `nombre` (`nombre`)
) ENGINE=InnoDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `continente` (
  `id_conti` int(11) NOT NULL AUTO_INCREMENT,
  `nombre` varchar(50) NOT NULL,
  PRIMARY KEY (`id_conti`),
  UNIQUE KEY `nombre` (`nombre`)
) ENGINE=InnoDB AUTO_INCREMENT=6 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `pais` (
  `id_pais` int(11) NOT NULL AUTO_INCREMENT,
  `nombre` varchar(100) NOT NULL,
  `id_conti` int(11) NOT NULL,
  PRIMARY KEY (`id_pais`),
  UNIQUE KEY `nombre` (`nombre`),
  KEY `fk_pais_continente` (`id_conti`)
) ENGINE=InnoDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `departamento` (
  `id_depart` int(11) NOT NULL AUTO_INCREMENT,
  `nombre` varchar(100) NOT NULL,
  `id_pais` int(11) NOT NULL,
  PRIMARY KEY (`id_depart`),
  KEY `fk_departamento_pais` (`id_pais`)
) ENGINE=InnoDB AUTO_INCREMENT=13 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `ciudad` (
  `id_cdad` int(11) NOT NULL AUTO_INCREMENT,
  `nombre` varchar(100) NOT NULL,
  `id_depart` int(11) NOT NULL,
  PRIMARY KEY (`id_cdad`),
  KEY `fk_ciudad_departamento` (`id_depart`)
) ENGINE=InnoDB AUTO_INCREMENT=26 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `ubicacion` (
  `id_ubi` int(11) NOT NULL AUTO_INCREMENT,
  `direccion` varchar(255) NOT NULL,
  `barrio` varchar(100) DEFAULT NULL,
  `codigo_postal` varchar(15) DEFAULT NULL,
  `latitud` decimal(10,8) NOT NULL,
  `longitud` decimal(11,8) NOT NULL,
  `descripcion` text DEFAULT NULL,
  `id_cdad` int(11) DEFAULT NULL,
  `activo` tinyint(1) DEFAULT 1,
  PRIMARY KEY (`id_ubi`),
  KEY `fk_ubicacion_ciudad` (`id_cdad`)
) ENGINE=InnoDB AUTO_INCREMENT=37 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `trayecto` (
  `id_tray` int(11) NOT NULL AUTO_INCREMENT,
  `id_origen` int(11) NOT NULL,
  `id_destino` int(11) NOT NULL,
  `distancia_km` decimal(10,2) NOT NULL,
  `tiempo_estimado_min` int(11) NOT NULL,
  `fecha_calculo` datetime DEFAULT current_timestamp(),
  PRIMARY KEY (`id_tray`),
  KEY `fk_trayecto_origen` (`id_origen`),
  KEY `fk_trayecto_destino` (`id_destino`)
) ENGINE=InnoDB AUTO_INCREMENT=8 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `gama` (
  `id_gama` int(11) NOT NULL AUTO_INCREMENT,
  `nombre` varchar(50) NOT NULL,
  `descripcion` text DEFAULT NULL,
  PRIMARY KEY (`id_gama`)
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `metodo_pago` (
  `id_met_pago` int(11) NOT NULL AUTO_INCREMENT,
  `nombre` varchar(80) NOT NULL,
  `descripcion` text DEFAULT NULL,
  PRIMARY KEY (`id_met_pago`)
) ENGINE=InnoDB AUTO_INCREMENT=6 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `politica` (
  `id_poli` int(11) NOT NULL AUTO_INCREMENT,
  `nombre` varchar(150) NOT NULL,
  `descripcion` text NOT NULL,
  `estado` enum('ACTIVA','INACTIVA') DEFAULT 'ACTIVA',
  PRIMARY KEY (`id_poli`)
) ENGINE=InnoDB AUTO_INCREMENT=6 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `condiciones` (
  `id_condi` int(11) NOT NULL AUTO_INCREMENT,
  `nombre` varchar(150) NOT NULL,
  `descripcion` text NOT NULL,
  `tipo` enum('CANCELACION','RESERVA','PAGO','USO','OTRO') DEFAULT 'OTRO',
  `estado` enum('ACTIVA','INACTIVA') DEFAULT 'ACTIVA',
  `id_poli` int(11) NOT NULL,
  PRIMARY KEY (`id_condi`),
  KEY `fk_condiciones_politica` (`id_poli`)
) ENGINE=InnoDB AUTO_INCREMENT=11 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `tp_servicio` (
  `id_tp_serv` int(11) NOT NULL AUTO_INCREMENT,
  `nombre` varchar(80) NOT NULL,
  `descripcion` text DEFAULT NULL,
  PRIMARY KEY (`id_tp_serv`),
  UNIQUE KEY `nombre` (`nombre`)
) ENGINE=InnoDB AUTO_INCREMENT=6 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `tp_turismo` (
  `id_tp_turi` int(11) NOT NULL AUTO_INCREMENT,
  `nombre` varchar(100) NOT NULL,
  `descripcion` text DEFAULT NULL,
  PRIMARY KEY (`id_tp_turi`),
  UNIQUE KEY `nombre` (`nombre`)
) ENGINE=InnoDB AUTO_INCREMENT=9 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `usuario` (
  `id_usu` int(11) NOT NULL AUTO_INCREMENT,
  `nombre` varchar(100) NOT NULL,
  `apellido` varchar(100) NOT NULL,
  `email` varchar(150) NOT NULL,
  `password_hash` varchar(255) NOT NULL,
  `id_rol` int(11) NOT NULL DEFAULT 1,
  `activo` tinyint(1) DEFAULT 1,
  `token_recuperacion` varchar(255) DEFAULT NULL,
  `token_expiracion` datetime DEFAULT NULL,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id_usu`),
  UNIQUE KEY `email` (`email`),
  KEY `fk_usuario_rol` (`id_rol`)
) ENGINE=InnoDB AUTO_INCREMENT=28 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `auditoria_rol` (
  `id_auditoria` int(11) NOT NULL AUTO_INCREMENT,
  `id_admin` int(11) NOT NULL,
  `id_usu_afectado` int(11) NOT NULL,
  `rol_anterior` int(11) NOT NULL,
  `rol_nuevo` int(11) NOT NULL,
  `motivo` varchar(255) DEFAULT NULL,
  `fecha_cambio` datetime DEFAULT current_timestamp(),
  PRIMARY KEY (`id_auditoria`),
  KEY `fk_audrol_admin` (`id_admin`),
  KEY `fk_audrol_afectado` (`id_usu_afectado`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `solicitud_proveedor` (
  `id_sp` int(11) NOT NULL AUTO_INCREMENT,
  `id_usu` int(11) NOT NULL,
  `nit` varchar(20) NOT NULL,
  `razon_social` varchar(150) NOT NULL,
  `telefono_contacto` varchar(20) NOT NULL,
  `cuenta_bancaria` varchar(50) NOT NULL,
  `banco` varchar(50) NOT NULL,
  `estado` enum('EN_REVISION','APROBADA','RECHAZADA') DEFAULT 'EN_REVISION',
  `fecha_solicitud` datetime DEFAULT current_timestamp(),
  `observaciones` text DEFAULT NULL,
  PRIMARY KEY (`id_sp`),
  UNIQUE KEY `nit` (`nit`),
  KEY `fk_solicitud_usuario` (`id_usu`)
) ENGINE=InnoDB AUTO_INCREMENT=18 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `documentos` (
  `id_doc` int(11) NOT NULL AUTO_INCREMENT,
  `id_usu` int(11) NOT NULL,
  `id_sp` int(11) DEFAULT NULL,
  `tipo_doc` varchar(100) NOT NULL,
  `nom_archivo` varchar(255) NOT NULL,
  `ruta_archivo` varchar(500) NOT NULL,
  `fecha_carga` datetime DEFAULT current_timestamp(),
  `estado` enum('PENDIENTE','APROBADO','RECHAZADO') DEFAULT 'PENDIENTE',
  PRIMARY KEY (`id_doc`),
  KEY `fk_documentos_usuario` (`id_usu`),
  KEY `fk_documentos_solicitud` (`id_sp`)
) ENGINE=InnoDB AUTO_INCREMENT=24 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `solicitud_tp_servicio` (
  `id_sol_serv` int(11) NOT NULL AUTO_INCREMENT,
  `id_sp` int(11) NOT NULL,
  `id_tp_serv` int(11) NOT NULL,
  PRIMARY KEY (`id_sol_serv`),
  KEY `fk_sol_serv_sp` (`id_sp`),
  KEY `fk_sol_serv_tp` (`id_tp_serv`)
) ENGINE=InnoDB AUTO_INCREMENT=23 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `proveedor` (
  `id_prov` int(11) NOT NULL AUTO_INCREMENT,
  `id_usu` int(11) NOT NULL,
  `id_sp` int(11) NOT NULL,
  `estado` enum('ACTIVO','INACTIVO','SUSPENDIDO') DEFAULT 'ACTIVO',
  `fecha_registro` datetime DEFAULT current_timestamp(),
  PRIMARY KEY (`id_prov`),
  UNIQUE KEY `id_usu` (`id_usu`),
  UNIQUE KEY `id_sp` (`id_sp`)
) ENGINE=InnoDB AUTO_INCREMENT=18 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `proveedor_tp_servicio` (
  `id_prov_serv` int(11) NOT NULL AUTO_INCREMENT,
  `id_prov` int(11) NOT NULL,
  `id_tp_serv` int(11) NOT NULL,
  PRIMARY KEY (`id_prov_serv`),
  KEY `fk_prov_serv_prov` (`id_prov`),
  KEY `fk_prov_serv_tp` (`id_tp_serv`)
) ENGINE=InnoDB AUTO_INCREMENT=30 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `servicio` (
  `id_servicio` int(11) NOT NULL AUTO_INCREMENT,
  `nombre` varchar(150) NOT NULL,
  `descripcion` text NOT NULL,
  `id_tp_serv` int(11) NOT NULL,
  `id_tp_turi` int(11) NOT NULL,
  `id_gama` int(11) NOT NULL,
  `id_prov` int(11) DEFAULT NULL,
  `id_ubi` int(11) NOT NULL,
  `disponibilidad` tinyint(1) DEFAULT 1,
  `activo` tinyint(1) DEFAULT 1,
  `fecha_creacion` datetime DEFAULT current_timestamp(),
  `updated_at` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id_servicio`),
  KEY `fk_servicio_tp_serv` (`id_tp_serv`),
  KEY `fk_servicio_tp_turi` (`id_tp_turi`),
  KEY `fk_servicio_gama` (`id_gama`),
  KEY `fk_servicio_proveedor` (`id_prov`),
  KEY `fk_servicio_ubicacion` (`id_ubi`)
) ENGINE=InnoDB AUTO_INCREMENT=181 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `servicio_condicion` (
  `id_servicio_condi` int(11) NOT NULL AUTO_INCREMENT,
  `id_servicio` int(11) NOT NULL,
  `id_condi` int(11) NOT NULL,
  PRIMARY KEY (`id_servicio_condi`),
  UNIQUE KEY `uq_servcondi` (`id_servicio`,`id_condi`),
  KEY `fk_servcondi_condicion` (`id_condi`)
) ENGINE=InnoDB AUTO_INCREMENT=343 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `servicio_gastronomia` (
  `id_gast` int(11) NOT NULL AUTO_INCREMENT,
  `id_servicio` int(11) NOT NULL,
  `nom_platillo_menu` varchar(100) NOT NULL,
  `porciones` int(11) DEFAULT 1,
  `vlr_estimado` decimal(10,2) NOT NULL,
  `horario_atencion` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`id_gast`),
  KEY `fk_gast_servicio` (`id_servicio`)
) ENGINE=InnoDB AUTO_INCREMENT=71 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `servicio_guia` (
  `id_guia` int(11) NOT NULL AUTO_INCREMENT,
  `id_servicio` int(11) NOT NULL,
  `nombre_tour` varchar(150) NOT NULL,
  `vlr_tour` decimal(10,2) NOT NULL,
  `duracion_horas` int(11) NOT NULL,
  `capacidad_grupo` int(11) NOT NULL,
  `dificultad` enum('BAJA','MEDIA','ALTA') DEFAULT 'MEDIA',
  `horario` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`id_guia`),
  KEY `fk_guia_servicio` (`id_servicio`)
) ENGINE=InnoDB AUTO_INCREMENT=36 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `servicio_hospedaje` (
  `id_hosp` int(11) NOT NULL AUTO_INCREMENT,
  `id_servicio` int(11) NOT NULL,
  `nom_unidad` varchar(100) NOT NULL,
  `capacidad_personas` int(11) NOT NULL,
  `vlr_noche` decimal(10,2) NOT NULL,
  `horario_checkin` varchar(50) DEFAULT NULL,
  `horario_checkout` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`id_hosp`),
  KEY `fk_hosp_servicio` (`id_servicio`)
) ENGINE=InnoDB AUTO_INCREMENT=68 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `servicio_imagen` (
  `id_img` int(11) NOT NULL AUTO_INCREMENT,
  `id_servicio` int(11) NOT NULL,
  `ruta_url` varchar(500) NOT NULL,
  `tipo_arch` varchar(50) NOT NULL,
  `es_principal` tinyint(1) DEFAULT 0,
  PRIMARY KEY (`id_img`),
  KEY `fk_servimg_servicio` (`id_servicio`)
) ENGINE=InnoDB AUTO_INCREMENT=181 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `servicio_recreacion` (
  `id_rec` int(11) NOT NULL AUTO_INCREMENT,
  `id_servicio` int(11) NOT NULL,
  `nom_actividad` varchar(150) NOT NULL,
  `duracion` varchar(50) DEFAULT NULL,
  `horario` varchar(100) DEFAULT NULL,
  `vlr_persona` decimal(10,2) DEFAULT 0.00,
  `capacidad` int(11) DEFAULT NULL,
  `es_evento_local` tinyint(1) DEFAULT 0,
  PRIMARY KEY (`id_rec`),
  KEY `fk_rec_servicio` (`id_servicio`)
) ENGINE=InnoDB AUTO_INCREMENT=40 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `servicio_transporte` (
  `id_trans` int(11) NOT NULL AUTO_INCREMENT,
  `id_servicio` int(11) NOT NULL,
  `tipo_vehiculo` varchar(80) NOT NULL,
  `capacidad_pasajeros` int(11) NOT NULL,
  `vlr_km` decimal(10,2) NOT NULL,
  `tarifa_base` decimal(10,2) NOT NULL,
  `horario_servicio` varchar(100) DEFAULT NULL,
  `es_ruta_programada` tinyint(1) DEFAULT 0,
  `id_origen` int(11) DEFAULT NULL,
  `id_destino` int(11) DEFAULT NULL,
  `fecha_salida` datetime DEFAULT NULL,
  PRIMARY KEY (`id_trans`),
  KEY `fk_trans_servicio` (`id_servicio`),
  KEY `fk_trans_ori` (`id_origen`),
  KEY `fk_trans_des` (`id_destino`)
) ENGINE=InnoDB AUTO_INCREMENT=37 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `plan_viaje` (
  `id_plan_viaje` int(11) NOT NULL AUTO_INCREMENT,
  `nombre_plan` varchar(100) NOT NULL,
  `fecha_inicio` date NOT NULL,
  `fecha_fin` date NOT NULL,
  `costo_total_estimado` decimal(10,2) DEFAULT 0.00,
  `estado` enum('DESEO','RESERVADO','CANCELADO','FINALIZADO') DEFAULT 'DESEO',
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  `id_usu` int(11) NOT NULL,
  `id_ubicacion_origen` int(11) DEFAULT NULL,
  `id_ubicacion_destino` int(11) DEFAULT NULL,
  PRIMARY KEY (`id_plan_viaje`),
  KEY `fk_plan_usuario` (`id_usu`),
  KEY `fk_plan_origen` (`id_ubicacion_origen`),
  KEY `fk_plan_destino` (`id_ubicacion_destino`)
) ENGINE=InnoDB AUTO_INCREMENT=13 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `det_plan_viaje` (
  `id_det_plan` int(11) NOT NULL AUTO_INCREMENT,
  `id_plan_viaje` int(11) NOT NULL,
  `id_servicio` int(11) DEFAULT NULL,
  `tipo_item` enum('HOSPEDAJE','GASTRONOMIA','RECREACION','TRANSPORTE','GUIA','TRANSPORTE_PROPIO','DESTINO_TURISTICO') NOT NULL DEFAULT 'DESTINO_TURISTICO',
  `id_item_especifico` int(11) DEFAULT NULL,
  `id_ubicacion_origen` int(11) DEFAULT NULL,
  `id_ubicacion_destino` int(11) DEFAULT NULL,
  `cantidad` int(11) DEFAULT 1,
  `fecha_servicio` date NOT NULL,
  `costo_unitario_calculado` decimal(10,2) NOT NULL,
  `subtotal_calculado` decimal(10,2) NOT NULL,
  `observaciones` varchar(255) DEFAULT NULL,
  `tiempo_estimado_min` int(11) DEFAULT 0,
  PRIMARY KEY (`id_det_plan`),
  KEY `fk_detplan_plan` (`id_plan_viaje`),
  KEY `fk_detplan_servicio` (`id_servicio`),
  KEY `fk_detplan_origen` (`id_ubicacion_origen`),
  KEY `fk_detplan_destino` (`id_ubicacion_destino`)
) ENGINE=InnoDB AUTO_INCREMENT=22 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `pagos` (
  `id_pago` int(11) NOT NULL AUTO_INCREMENT,
  `id_plan_viaje` int(11) NOT NULL,
  `id_met_pago` int(11) NOT NULL,
  `valor_total` decimal(10,2) NOT NULL,
  `estado` enum('PENDIENTE','APROBADO','RECHAZADO','REEMBOLSADO') DEFAULT 'PENDIENTE',
  `referencia_transaccion` varchar(100) NOT NULL,
  `fecha_pago` datetime DEFAULT current_timestamp(),
  PRIMARY KEY (`id_pago`),
  UNIQUE KEY `referencia_transaccion` (`referencia_transaccion`),
  KEY `fk_pago_plan` (`id_plan_viaje`),
  KEY `fk_pago_metodo` (`id_met_pago`)
) ENGINE=InnoDB AUTO_INCREMENT=6 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `pago_proveedor` (
  `id_pago_prov` int(11) NOT NULL AUTO_INCREMENT,
  `id_pago` int(11) NOT NULL,
  `id_prov` int(11) NOT NULL,
  `monto_subtotal` decimal(10,2) NOT NULL,
  `comision_plataforma` decimal(10,2) DEFAULT 0.00,
  `monto_neto_proveedor` decimal(10,2) NOT NULL,
  `estado_transferencia` enum('PENDIENTE','TRANSFERIDO','RETENIDO') DEFAULT 'PENDIENTE',
  `fecha_transferencia` datetime DEFAULT NULL,
  PRIMARY KEY (`id_pago_prov`),
  KEY `fk_pagoprov_pago` (`id_pago`),
  KEY `fk_pagoprov_proveedor` (`id_prov`)
) ENGINE=InnoDB AUTO_INCREMENT=12 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `resenas` (
  `id_resena` int(11) NOT NULL AUTO_INCREMENT,
  `id_usu` int(11) NOT NULL,
  `id_servicio` int(11) NOT NULL,
  `clf_general` decimal(2,1) NOT NULL CHECK (`clf_general` between 1.0 and 5.0),
  `comentario` varchar(1000) DEFAULT NULL,
  `fecha_resena` datetime DEFAULT current_timestamp(),
  `estado` enum('ACTIVA','OCULTA','REPORTADA') DEFAULT 'ACTIVA',
  `respuesta_proveedor` varchar(1000) DEFAULT NULL,
  `fecha_respuesta` datetime DEFAULT NULL,
  PRIMARY KEY (`id_resena`),
  UNIQUE KEY `uq_resena_usuario_servicio` (`id_usu`,`id_servicio`),
  KEY `fk_resena_servicio` (`id_servicio`)
) ENGINE=InnoDB AUTO_INCREMENT=10 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

CREATE TABLE `detalle_resenas` (
  `id_detalle_resena` int(11) NOT NULL AUTO_INCREMENT,
  `id_resena` int(11) NOT NULL,
  `criterio` varchar(100) NOT NULL,
  `calificacion` decimal(2,1) NOT NULL CHECK (`calificacion` between 1.0 and 5.0),
  PRIMARY KEY (`id_detalle_resena`),
  KEY `fk_detresena_resena` (`id_resena`)
) ENGINE=InnoDB AUTO_INCREMENT=23 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

