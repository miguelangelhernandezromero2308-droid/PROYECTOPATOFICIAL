  border-radius: var(--radius-sm);
  overflow: hidden;
  border: 1px solid var(--border);
}

.gallery-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.gallery-thumb button {
  position: absolute;
  top: 4px;
  right: 4px;
  width: 22px;
