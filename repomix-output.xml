const API_URL = "http://127.0.0.1:8000";
let token = localStorage.getItem("token");
let ubicacionesList = []; 
let todosLosServicios = [];
let planActual = null; 
let tipoServicioActual = "";
let mapaCrearPlanInstance = null; 
let controlRuta = null; 
