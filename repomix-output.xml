<file path="frontend/restablecer_contrasena.html">
<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Nueva Contraseña - PAT</title>

    <link
        rel="stylesheet"
        href="css/styles_login.css"
    >

    <link
        rel="icon"
        type="image/png"
        href="./img/Designer_icon.png"
    >

</head>


<body>

<div class="form-container">

    <h2>Nueva Contraseña</h2>


    <form id="resetForm">

        <div class="input-box">

            <input
                type="password"
                id="newPassword"
                placeholder=" "
                required
            >

            <span>Nueva Contraseña</span>

        </div>


        <div class="input-box">

            <input
                type="password"
                id="confirmPassword"
                placeholder=" "
                required
            >

            <span>Confirmar Contraseña</span>

        </div>


        <button
            type="submit"
            class="submit-btn"
        >
            Guardar
        </button>

    </form>

</div>


<script>

const API_URL = "http://127.0.0.1:8000";


// ==========================================
// OBTENER TOKEN DE LA URL
// ==========================================

const urlParams =
    new URLSearchParams(
        window.location.search
    );


const token =
    urlParams.get("token");


if (!token) {

    alert(
        "Token no válido o ausente. " +
        "Solicita la recuperación de nuevo."
    );


    window.location.href =
        "solicitar_recuperacion.html";
}


// ==========================================
// RESTABLECER CONTRASEÑA
// ==========================================

document
    .getElementById("resetForm")
    .addEventListener("submit", async (e) => {

        e.preventDefault();


        const newPassword =
            document
                .getElementById("newPassword")
                .value;


        const confirmPassword =
            document
                .getElementById("confirmPassword")
                .value;


        // ==========================================
        // VALIDAR CONTRASEÑAS
        // ==========================================

        if (
            newPassword !==
            confirmPassword
        ) {

            alert(
                "Las contraseñas no coinciden."
            );

            return;
        }


        if (newPassword.length < 8) {

            alert(
                "La contraseña debe tener mínimo 8 caracteres."
            );

            return;
        }


        try {

            const response = await fetch(
                `${API_URL}/auth/reset-password`,
                {

                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({

                        token: token,

                        new_password:
                            newPassword

                    })
                }
            );


            const data =
                await response.json();


            // ==========================================
            // CONTRASEÑA ACTUALIZADA
            // ==========================================

            if (response.ok) {

                alert(
                    "¡Contraseña actualizada con éxito! " +
                    "Ahora puedes iniciar sesión con tu nueva contraseña."
                );


                window.location.href =
                    "login.html";


            } else {

                alert(
                    data.detail ||
                    "Error al cambiar la contraseña. " +
                    "Es posible que el token haya expirado."
                );
            }


        } catch (error) {

            console.error(
                "Error:",
                error
            );

            alert(
                "No se pudo conectar con el servidor."
            );
        }

    });

</script>

</body>

</html>
</file>

<file path="frontend/solicitar_recuperacion.html">
<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Recuperar Contraseña - PAT</title>

    <link
        rel="stylesheet"
        href="css/styles_login.css"
    >

    <link
        rel="icon"
        type="image/png"
        href="./img/Designer_icon.png"
    >

</head>


<body>

<div class="form-container">

    <h2>Recuperar Contraseña</h2>

    <p
        style="
            color: #ccc;
            font-size: 14px;
            margin-bottom: 20px;
        "
    >
        Ingresa tu correo registrado y te
        generaremos las instrucciones de recuperación.
    </p>


    <form id="forgotForm">

        <div class="input-box">

            <input
                type="email"
                id="email"
                placeholder=" "
                required
            >

            <span>Email</span>

        </div>


        <button
            type="submit"
            class="submit-btn"
        >
            Enviar
        </button>

    </form>


    <div class="login-link">

        <p
            style="
                color:#fff;
                margin-top:15px;
            "
        >

            <a href="login.html">
                Volver al Login
            </a>

        </p>

    </div>

</div>


<script>

const API_URL = "http://127.0.0.1:8000";


document
    .getElementById("forgotForm")
    .addEventListener("submit", async (e) => {

        e.preventDefault();


        const email = document
            .getElementById("email")
            .value
            .trim();


        if (!email) {

            alert(
                "Por favor ingresa tu correo."
            );

            return;
        }


        try {

            const response = await fetch(
                `${API_URL}/auth/forgot-password`,
                {

                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body: JSON.stringify({
                        email: email
                    })
                }
            );


            const data = await response.json();


            if (response.ok) {


                // ==========================================
                // TOKEN DE DESARROLLO
                // ==========================================

                if (data.token_desarrollo) {

                    alert(
                        "¡Token generado con éxito! " +
                        "En un entorno real se enviaría por correo."
                    );


                    window.location.href =
                        `restablecer_contrasena.html?token=${encodeURIComponent(
                            data.token_desarrollo
                        )}`;


                } else {

                    alert(
                        data.mensaje ||
                        "Solicitud procesada correctamente."
                    );
                }


            } else {

                alert(
                    data.detail ||
                    "Error al procesar la solicitud."
                );
            }


        } catch (error) {

            console.error(
                "Error:",
                error
            );

            alert(
                "No se pudo conectar con el servidor."
            );
        }

    });

</script>

</body>

</html>
