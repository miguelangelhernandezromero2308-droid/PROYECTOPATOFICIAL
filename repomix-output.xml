const API_URL = "http://127.0.0.1:8000";


// ==========================================
// REGISTRO
// ==========================================

document
    .getElementById("registerForm")
    .addEventListener("submit", async (e) => {

        e.preventDefault();


        const nombre = document
            .getElementById("nombre")
            .value
            .trim();

